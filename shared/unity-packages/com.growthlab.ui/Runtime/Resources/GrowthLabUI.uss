/* GrowthLab UI — dark dashboard theme. Change colours via the variables below. */
:root {
    --gl-bg: rgba(16, 19, 26, 0.92);
    --gl-surface: rgb(30, 35, 46);
    --gl-border: rgb(52, 60, 76);
    --gl-text: rgb(230, 234, 242);
    --gl-text-dim: rgb(150, 160, 178);
    --gl-accent: rgb(84, 160, 255);
    --gl-normal: rgb(64, 190, 120);
    --gl-info: rgb(84, 160, 255);
    --gl-warning: rgb(240, 190, 60);
    --gl-alarm: rgb(235, 80, 70);
    --gl-offline: rgb(120, 128, 140);
    --gl-radius: 6px;
    color: var(--gl-text);
    font-size: 13px;
}

/* ---------- layout ---------- */
.gl-screen { flex-grow: 1; flex-direction: row; padding: 12px; }
.gl-panel { background-color: var(--gl-bg); border-radius: var(--gl-radius); border-width: 1px; border-color: var(--gl-border); padding: 12px; }
.gl-sidebar { width: 360px; }
.gl-bottombar { position: absolute; left: 12px; right: 12px; bottom: 12px; flex-direction: row; }
.gl-row { flex-direction: row; align-items: center; }
.gl-column { flex-direction: column; }
.gl-grow { flex-grow: 1; }
.gl-spacer { flex-grow: 1; }
.gl-gap > * { margin-bottom: 8px; }
.gl-title { font-size: 18px; -unity-font-style: bold; color: var(--gl-text); margin-bottom: 2px; }
.gl-subtitle { font-size: 12px; color: var(--gl-text-dim); margin-bottom: 10px; }
.gl-section { font-size: 12px; -unity-font-style: bold; color: var(--gl-text-dim); margin-top: 10px; margin-bottom: 6px; }

/* ---------- StatusBadge ---------- */
.gl-badge { font-size: 11px; -unity-font-style: bold; padding: 2px 8px; border-radius: 10px; color: rgb(16, 19, 26); background-color: var(--gl-info); -unity-text-align: middle-center; }
.gl-badge--normal { background-color: var(--gl-normal); }
.gl-badge--info { background-color: var(--gl-info); }
.gl-badge--warning { background-color: var(--gl-warning); }
.gl-badge--alarm { background-color: var(--gl-alarm); color: white; }
.gl-badge--offline { background-color: var(--gl-offline); color: white; }

/* ---------- StatCard ---------- */
.gl-card { background-color: var(--gl-surface); border-radius: var(--gl-radius); border-width: 1px; border-color: var(--gl-border); padding: 10px; margin-bottom: 8px; }
.gl-card__header { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 6px; }
.gl-card__title { font-size: 14px; -unity-font-style: bold; }
.gl-card__body > * { margin-bottom: 6px; }

/* ---------- Gauge ---------- */
.gl-gauge { margin-bottom: 4px; }
.gl-gauge__header { flex-direction: row; justify-content: space-between; margin-bottom: 3px; }
.gl-gauge__label { color: var(--gl-text-dim); font-size: 12px; }
.gl-gauge__value { font-size: 12px; -unity-font-style: bold; }
.gl-gauge__track { height: 8px; border-radius: 4px; background-color: rgb(44, 51, 66); overflow: hidden; }
.gl-gauge__fill { height: 100%; border-radius: 4px; background-color: var(--gl-normal); }
.gl-gauge--warning .gl-gauge__fill { background-color: var(--gl-warning); }
.gl-gauge--alarm .gl-gauge__fill { background-color: var(--gl-alarm); }
.gl-gauge--alarm .gl-gauge__value { color: var(--gl-alarm); }

/* ---------- MessageList ---------- */
.gl-messages { min-height: 80px; }
.gl-messages__empty { color: var(--gl-text-dim); font-size: 12px; }
.gl-messages__row { flex-direction: row; padding: 3px 6px; margin-bottom: 2px; border-left-width: 3px; border-color: var(--gl-info); background-color: rgba(255, 255, 255, 0.03); }
.gl-messages__row.gl-badge--normal { border-color: var(--gl-normal); }
.gl-messages__row.gl-badge--warning { border-color: var(--gl-warning); }
.gl-messages__row.gl-badge--alarm { border-color: var(--gl-alarm); }
.gl-messages__row.gl-badge--offline { border-color: var(--gl-offline); }
.gl-messages__row-time { color: var(--gl-text-dim); font-size: 11px; width: 62px; }
.gl-messages__row-text { font-size: 12px; flex-shrink: 1; white-space: normal; }

/* ---------- World labels ---------- */
.gl-world-label { padding: 2px 6px; border-radius: 4px; background-color: rgba(16, 19, 26, 0.85); font-size: 11px; }
.gl-world-label.gl-badge { background-color: var(--gl-normal); }
.gl-world-label.gl-badge--warning { background-color: var(--gl-warning); }
.gl-world-label.gl-badge--alarm { background-color: var(--gl-alarm); }

/* ---------- Default controls ---------- */
Button { background-color: var(--gl-surface); border-color: var(--gl-border); color: var(--gl-text); border-radius: 4px; padding: 4px 10px; }
Button:hover { background-color: rgb(42, 49, 64); }

/* ---------- ScrollView (dark scrollbars) ---------- */
.gl-screen .unity-scroller--vertical { width: 8px; }
.gl-screen .unity-scroller .unity-base-slider__tracker { background-color: rgba(255, 255, 255, 0.04); border-width: 0; }
.gl-screen .unity-scroller .unity-base-slider__dragger { background-color: var(--gl-border); border-width: 0; border-radius: 4px; }
.gl-screen .unity-scroller__low-button, .gl-screen .unity-scroller__high-button { display: none; }

/* ---------- Charts (GrowthLab.UI.Charts) ---------- */
.gl-chart { --gl-chart-grid: rgba(255, 255, 255, 0.07); --gl-chart-track: rgba(255, 255, 255, 0.10); margin-bottom: 4px; }
.gl-chart__header { flex-direction: row; flex-wrap: wrap; align-items: center; justify-content: space-between; margin-bottom: 4px; }
.gl-chart__title { font-size: 12px; -unity-font-style: bold; color: var(--gl-text); padding: 0; margin: 0 8px 0 0; }
.gl-chart__legend { flex-direction: row; flex-wrap: wrap; }
.gl-chart__legend-item { flex-direction: row; align-items: center; margin-left: 8px; }
.gl-chart__swatch { width: 8px; height: 8px; border-radius: 2px; margin-right: 4px; }
.gl-chart__legend-text { font-size: 10px; color: var(--gl-text-dim); padding: 0; margin: 0; }
.gl-chart__plot { position: relative; overflow: hidden; }
.gl-chart__labels { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }
.gl-chart__label { font-size: 9px; color: var(--gl-text-dim); padding: 0; margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.gl-chart__label--category { font-size: 9px; -unity-text-align: upper-center; }
.gl-chart__label--value { font-size: 9px; color: var(--gl-text); -unity-font-style: bold; }
.gl-chart__label--row { font-size: 10px; color: var(--gl-text); }
.gl-chart__label--marker { font-size: 9px; color: var(--gl-alarm); -unity-font-style: bold; }
.gl-chart__label--center { font-size: 20px; color: var(--gl-text); -unity-font-style: bold; }
.gl-chart__label--center-caption { font-size: 9px; }
.gl-chart__tooltip { position: absolute; font-size: 10px; color: var(--gl-text); background-color: rgba(8, 12, 20, 0.94);
    border-radius: 5px; border-width: 1px; border-color: var(--gl-border); padding: 4px 7px; margin: 0; white-space: normal; max-width: 220px; }
.gl-chart__empty { font-size: 11px; color: var(--gl-text-dim); padding: 10px 0; -unity-text-align: middle-center; white-space: normal; }
.gl-chart__caption { font-size: 10px; color: var(--gl-text-dim); padding: 0; margin: 3px 0 0 0; white-space: normal; }
